# Machine configuration — copy this file to ".env" (excluded from Git) and adapt it.
# Full documentation: docs/configuration.md
# The same .env serves the editing PC and the server: deploy_linux.ps1 copies it to the server.

# --- Publishing server (used from the PC: deployment, video upload, authorization tunnel)
VS_SERVER=user@192.168.1.10
VS_SERVER_DIR=/srv/video-studio

# --- Secret storage (used where publishing happens: the server)
# files  : JSON files in secrets/ (not recommended, clear text)
# gopass : gopass vault, under the prefix below
VS_SECRETS_BACKEND=gopass
VS_GOPASS_PREFIX=video-studio
# Command used instead of "gopass" (e.g. a wrapper selecting the vault profile). Empty = gopass from PATH.
VS_GOPASS_CMD=

# --- TikTok permissions requested (append ,video.list once the Display API product is enabled: statistics)
VS_TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# --- Browser for the OAuth authorization pages (Windows PC)
VS_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
VS_CHROME_PROFILE=Default
